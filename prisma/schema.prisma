// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Image {
  id           String   @id @default(cuid())
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  data         Bytes
  createdAt    DateTime @default(now())
}